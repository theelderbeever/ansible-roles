{{ ansible_managed | comment }}
{% for key, value in _pihole_ftl_config | dictsort %}
{%   if value is boolean %}
{%     set rendered = value | lower %}
{%   elif value is iterable and value is not string and value is not mapping %}
{%     set rendered = value | join(';') %}
{%   else %}
{%     set rendered = value | string %}
{%   endif %}
FTLCONF_{{ key | replace('.', '_') }}="{{ rendered | replace('\\', '\\\\') | replace('"', '\\"') }}"
{% endfor %}
